<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Splash background matching the CineCode-AI icon background (splash_colors.xml) -->
    <item android:drawable="@color/splash_bg" />

    <!-- Centered CineCode-AI Logo -->
    <item
        android:gravity="center"
        android:width="180dp"
        android:height="180dp">
        <bitmap
            android:src="@drawable/ic_launcher_foreground_cinecode"
            android:filter="true"
            android:antialias="true"
            android:dither="true"
            android:gravity="center" />
    </item>
</layer-list>
